---
// Define the array of projects directly in the frontmatter script.
const otherprojects = [
  {
    //url: "https://www.lexingtonthemes.com/",
    title: "Craniofacial Gastruloids",
    description: "developed a 3D model to mimic early craniafacial development.",
    description1: "answered to the unmet need of a physiologically-relevant model to capture the coordinated, multi-tissue context of early craniofacial specification,  with the relevant tissue architecture and interactions that set up the craniofacial field.",
    description2: "useful for mechanistic research, disease modeling, drug/teratogen screening, tissue sourcing."
  },
  {
    //url: "https://github.com/gimura0/image_analysis/",
    title: "Image analysis automation",
    description: "developed an integrated image analysis workflow combining NIS-Elements JOBS, ImageJ macros, and Python scripts.",
    description1: "dozens of samples/week to process. Launched an fruitfull cross-functional collaboration with the imaging platform manager and two incredibily talented engineering and computational biology students.",
    description2: " result? +40% throughput, -85% active operator time = ~350–600h/year gained (~€10,000–20,000 in labour cost). Not bad."
  },
  {
    title: "Portfolio",
    description: "you are looking at it! This was definitely a very fun project, the first of its kind for me.",
    description1: "here and in my blog (under development) I try to showcase my knowledge, skills, thought process, and ambitions.",
    description2: ""
  },
  {
    title: "The Future Project",
    description: "who knows, maybe it will be our project together! ✌︎"
  },
  // Add more projects as needed...
];

// Function to calculate `data-aos-duration` based on index
function calculateAosDuration(index) {
  return 1500 + index * 500; // Example: Increment duration by 500ms for each project
}
---

<section class="bg-primary">
  <div class="px-8 2xl:max-w-7xl mx-auto py-32">
    <div class="space-y-2">
      <!-- Section Title and Decorative Elements -->
      <div
        class="h-0.5 bg-secondary"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
      </div>
      <h3
        class="text-secondary text-base font-medium"
        data-aos="fade-up"
        data-aos-duration="1500"
      >
        <span>Main</span>
        <span class="font-bold">projects</span>
      </h3>
    </div>

    <ul
      class="mx-auto grid grid-cols-1 sm:grid-cols-2 text-secondary lg:grid-cols-4 items-start gap-6 mt-32"
      role="list"
    >
      {
        otherprojects.map((project, index) => (
          <li
            class="flow-root h-full "
            data-aos="fade-up"
            data-aos-duration={calculateAosDuration(index)}
          >
            <a href={project.url}>
              <div class="h-full flex flex-col justify-between">
                <div>
                  <p class="group-hover:text-secondary/70 text-secondary text-9xl font-black lg:rotate-90 xl:-translate-x-32 lg:-translate-x-20 lg:mb-8 xl:mb-0  lg:pb-8">
                    0{index + 1}.
                  </p>
                  <p class="italic shrink-0">{project.title}</p>
                  <p class="text-xl  mt-3 indent-9">{project.description}</p>
                  <p class="text-xl  mt-3 indent-9">{project.description1}</p>
                  <p class="text-xl  mt-3 indent-9">{project.description2}</p>
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
